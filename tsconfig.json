{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  // The shared code and the Cloudflare entry; src/bun has tsconfig.bun.json.
  "include": ["src/**/*.ts"],
  "exclude": ["src/bun"]
}
