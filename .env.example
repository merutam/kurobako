# Settings for compose.yaml. ops/init-env.sh writes a .env with fresh secrets.
# Unset values take the defaults listed in README.md.

# Port on 127.0.0.1 where the server listens.
PORT=3000

# --- File storage ------------------------------------------------------------

# Garage, which compose.yaml runs next to the server: its cluster secret
# (64 hex characters) and the server's key ("GK" + 24 hex characters, and 64
# hex characters).
GARAGE_RPC_SECRET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Another S3-compatible store instead, such as Cloudflare R2: its address,
# region, bucket and keys (above), then start the server alone:
#   podman compose up -d --build --no-deps kurobako
# For R2: https://<account id>.r2.cloudflarestorage.com and region "auto".
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=

# --- Access ------------------------------------------------------------------

# Enables the admin dashboard at /a (at least 32 characters).
ADMIN_KEY=

# A private instance: only who has this key gets in (at least 16 characters).
ACCESS_KEY=
# In a private instance, whether share links still open for anyone.
PUBLIC_SHARES=

# --- Behind a proxy ----------------------------------------------------------

# The header with the client's address, e.g. x-forwarded-for, or
# cf-connecting-ip behind Cloudflare.
CLIENT_IP_HEADER=

# The site's public address, for absolute links such as share links, e.g.
# https://box.example. Unset, it comes from each request (and, behind a proxy
# set in CLIENT_IP_HEADER, from its X-Forwarded-Proto and X-Forwarded-Host).
PUBLIC_URL=

# Where the site lives under its domain, to share it with another site: /k.
BASE_PATH=

# --- Keeping and limits --------------------------------------------------------

# 0: items never expire.
ITEM_TTL_SECONDS=
# Every item together, in bytes; unset for no limit.
MAX_STORAGE_BYTES=
# Hosting, cloud and VPN networks and Tor: allow, limit (the default) or block.
AUTOMATED_NETWORKS=

# Texts above this many bytes live in the file store instead of SQLite.
INLINE_TEXT_BYTES=

# Namespace SQLite connections are opened lazily and closed when idle.
SQLITE_MAX_OPEN=
SQLITE_IDLE_SECONDS=
