# Settings for compose.yaml. ops/init-env.sh writes a .env with fresh secrets.

# Port on 127.0.0.1 where the server listens.
PORT=3000

# Garage's cluster secret: 64 hex characters.
GARAGE_RPC_SECRET=
# The server's key for Garage: "GK" + 24 hex characters, and 64 hex characters.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Enables the admin dashboard at /a (at least 32 characters).
ADMIN_KEY=

# Behind a reverse proxy: the header with the client's address, e.g.
# x-forwarded-for, or cf-connecting-ip behind Cloudflare.
CLIENT_IP_HEADER=

# The site's public address, for absolute links such as share links, e.g.
# https://box.example. Unset, it comes from each request (and, behind a proxy
# set in CLIENT_IP_HEADER, from its X-Forwarded-Proto and X-Forwarded-Host).
PUBLIC_URL=
