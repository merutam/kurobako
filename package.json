{
  "name": "kurobako",
  "version": "0.8.20",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler dev",
    "deploy": "wrangler deploy",
    "start": "bun src/infrastructure/bun/server.ts",
    "build": "bun --no-env-file ops/build.ts",
    "test": "bun run build && vitest run && bun test test/bun test/regressions.test.ts",
    "types": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types src/worker-configuration.d.ts",
    "typecheck": "bun run types && tsc --noEmit && tsc --noEmit -p test && tsc --noEmit -p tsconfig.bun.json && tsc --noEmit -p test/browser",
    "lint": "biome check .",
    "format": "biome check --write .",
    "version": "bun ops/version.ts && git add src/sdk/k.mjs public/k.mjs",
    "test:browser": "bun run build && playwright test"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@playwright/test": "^1.65.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  },
  "license": "AGPL-3.0-or-later"
}
