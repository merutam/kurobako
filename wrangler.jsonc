{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kurobako",
  "main": "src/cloudflare/worker.ts",
  // The account that owns the R2 bucket below.
  "account_id": "e78e21c9934eecfbbd91fced877e9153",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  // Only reachable at its own domain, so the zone's WAF and rate limiting
  // rules apply to every request (workers.dev would bypass them).
  "workers_dev": false,
  "routes": [
    { "pattern": "kurobako.mugens.org", "custom_domain": true },
    { "pattern": "k.mugens.org", "custom_domain": true }
  ],

  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },

  // Public limits. ADMIN_KEY is a secret: `wrangler secret put ADMIN_KEY`
  // (and .dev.vars for local development); leaving it unset disables /a.
  "vars": {
    "MAX_FILE_BYTES": "100000000",
    "MAX_TEXT_BYTES": "1000000",
    "INLINE_TEXT_BYTES": "64000",
    "ITEM_TTL_SECONDS": "86400",
    "MAX_ITEMS": "20",
    "MAX_LIVE_CONNECTIONS": "100",
    "EMPTY_NAMESPACE_TTL_SECONDS": "3600",
    "ADMIN_SESSION_HOURS": "12",
    // What clients are told (/.well-known/kurobako); the limit itself is
    // UPLOAD_LIMITER's below, which must say the same.
    "SENDS_PER_MINUTE": "30",
    // The same for MISSES_PER_MINUTE and MISS_LIMITER below.
    "MISSES_PER_MINUTE": "30"
  },

  // Private: only this Worker reads and writes it, so burn-after-reading,
  // expiry and namespace privacy hold. Never make this bucket public.
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "kurobako" }],

  "durable_objects": {
    "bindings": [
      // One object per namespace: its queue, access log and live sockets.
      { "name": "NAMESPACES", "class_name": "NamespaceObject" },
      // A single object for site-wide stats and the admin dashboard.
      { "name": "HUB", "class_name": "HubObject" }
    ]
  },
  "exports": {
    "NamespaceObject": { "type": "durable-object", "storage": "sqlite" },
    "HubObject": { "type": "durable-object", "storage": "sqlite" }
  },

  "version_metadata": { "binding": "VERSION" },

  // Sends, and requests that find nothing (src/api/misses.ts), per client.
  // Counted per Cloudflare location and approximate by design: they slow
  // scripts down, they are not accounting.
  "ratelimits": [
    { "name": "UPLOAD_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "MISS_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],

  // Renders the protocol and the licenses into public/k/ (see STATIC_PAGES).
  // --no-env-file: .env configures the Bun server, not this deployment.
  "build": { "command": "bun --no-env-file ops/pages.ts" },

  // Scripts, styles, icons and the pages that never change are served straight
  // from Workers Static Assets, which costs no Worker request or CPU. Pages
  // with data go to the Worker, which renders them with it (src/views/).
  // The files are named one by one (the STATIC_FILES, ICON_FILES and
  // STATIC_PAGES of src/pages.ts): a pattern such as "!/*.js" would also catch
  // /k/common.js, which under BASE_PATH=/k only the Worker can serve.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/namespaces/index.js",
      "!/namespaces/modes.js",
      "!/namespaces/item-list.js",
      "!/namespaces/live.js",
      "!/namespaces/forms.js",
      "!/namespaces/access.js",
      "!/home.js",
      "!/item.js",
      "!/view.js",
      "!/common.js",
      "!/components.js",
      "!/items.js",
      "!/item-row.js",
      "!/format.js",
      "!/dom.js",
      "!/icons.js",
      "!/access.js",
      "!/media-feed.js",
      "!/text-editor.js",
      "!/sw.js",
      "!/admin.js",
      "!/login.js",
      "!/log.js",
      "!/unlocking.js",
      "!/k.mjs",
      "!/status.js",
      "!/theme.js",
      "!/scroll-top.js",
      "!/styles.css",
      "!/tokens.css",
      "!/vendor/highlight.js",
      "!/vendor/uqr.js",
      "!/favicon.ico",
      "!/apple-touch-icon.png",
      "!/logo.png",
      "!/k/protocol",
      "!/k/licenses"
    ],
    // /k/protocol is public/k/protocol.html.
    "html_handling": "drop-trailing-slash"
  }
}
