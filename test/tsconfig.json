{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node", "@cloudflare/vitest-plugin/types"],
    "allowImportingTsExtensions": true,
    "allowJs": true
  },
  // The Worker tests; bun/ is checked with tsconfig.bun.json.
  "include": ["./**/*.ts", "../src/**/*.ts", "../src/**/*.tsx", "../vitest.config.ts"],
  "exclude": [
    "../src/infrastructure/bun",
    "../src/web/client/build.ts",
    "./bun",
    "./regressions.test.ts",
    "./browser"
  ]
}
